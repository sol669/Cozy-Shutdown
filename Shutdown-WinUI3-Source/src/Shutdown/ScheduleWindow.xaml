<Window
    x:Class="ShutdownApp.ScheduleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cozy Shutdown">
    <Grid x:Name="RootGrid" Padding="28,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="QuestionText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <StackPanel x:Name="IntervalPanel" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <NumberBox x:Name="IntervalNumber" Width="170" Minimum="1" Maximum="10080"
                       Value="30" SpinButtonPlacementMode="Compact"/>
            <ComboBox x:Name="UnitCombo" Width="180" SelectedIndex="0">
                <ComboBoxItem x:Name="MinutesItem"/>
                <ComboBoxItem x:Name="HoursItem"/>
            </ComboBox>
        </StackPanel>

        <StackPanel x:Name="DateTimePanel" Grid.Row="1" VerticalAlignment="Center" Spacing="10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DateLabel" VerticalAlignment="Center"/>
                <CalendarDatePicker x:Name="ActionDate" Grid.Column="1" HorizontalAlignment="Stretch"
                                    Height="40" VerticalAlignment="Center"
                                    BorderThickness="1" CornerRadius="4"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"/>
            </Grid>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeLabel" VerticalAlignment="Center"/>
                <TimePicker x:Name="ActionTime" Grid.Column="1" ClockIdentifier="24HourClock"
                            HorizontalAlignment="Stretch" Height="40" VerticalAlignment="Center"
                            BorderThickness="1" CornerRadius="4"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" MinWidth="110" Click="CancelButton_Click"/>
            <Button x:Name="ScheduleButton" Grid.Column="2" MinWidth="130" Style="{StaticResource AccentButtonStyle}" Click="ScheduleButton_Click"/>
        </Grid>
    </Grid>
</Window>
